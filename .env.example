# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# Use `.env` (not `.env.local`) — the Prisma CLI only reads `.env`, while Next.js
# reads both, so a single `.env` keeps the app and the CLI in agreement.
# NEVER commit `.env` or `.env.local` — they are excluded by .gitignore.
#
# If the database was added through the Vercel Marketplace, skip the manual step:
#   vercel env pull .env
# ---------------------------------------------------------------------------

# Postgres connection string — the POOLED one.
# On Neon this is the host containing `-pooler`. It is what a serverless
# deployment needs: many short-lived function instances sharing few connections.
#   Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Walkthrough in db/README.md.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Same database, UNPOOLED host (no `-pooler`). Used only by the Prisma CLI.
# `prisma db push` takes a session-level advisory lock, which the pooled endpoint
# cannot hold. Optional: if unset, the CLI falls back to DATABASE_URL, which is
# fine for a plain Postgres server that has no pooled/unpooled split.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Secret used by Auth.js to sign and encrypt the session cookie.
# Generate one with:  npx auth secret     (or)   openssl rand -base64 32
AUTH_SECRET=""

# Admin panel credentials.
# These replace the values that were hardcoded in login.php:4-5.
# The old ones are public in this repository's git history and MUST be rotated —
# do not reuse them. See PROJECT_ANALYSIS.md §7 finding 1.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Public base URL of the deployed app. Used for absolute links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
