# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# Use `.env` (not `.env.local`) — the Prisma CLI only reads `.env`, while Next.js
# reads both, so a single `.env` keeps the app and the CLI in agreement.
# NEVER commit `.env` or `.env.local` — they are excluded by .gitignore.
# ---------------------------------------------------------------------------

# MySQL connection string.
# The old config.php pointed at "localhost". Vercel runs remotely, so this host
# must be reachable from the public internet (or via a tunnel/proxy) and should
# require TLS. Append ?sslaccept=strict once the server presents a valid cert.
#   Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
#
# On Railway: copy MYSQL_PUBLIC_URL from the database service's Variables tab —
# NOT MYSQL_URL, which is private and unreachable from Vercel. The proxy port is
# a random high port, not 3306. Full walkthrough in db/README.md.
# Percent-encode any @ / : # in the password (@ becomes %40).
DATABASE_URL="mysql://user:password@host:3306/database"

# Secret used by Auth.js to sign and encrypt the session cookie.
# Generate one with:  npx auth secret     (or)   openssl rand -base64 32
AUTH_SECRET=""

# Admin panel credentials.
# These replace the values that were hardcoded in login.php:4-5.
# The old ones are public in this repository's git history and MUST be rotated —
# do not reuse them. See PROJECT_ANALYSIS.md §7 finding 1.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Public base URL of the deployed app. Used for absolute links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
