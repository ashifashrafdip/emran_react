// Prisma schema for the Emran admin panel.
//
// This is the single source of truth for the database shape. Apply it with:
//
//     npm run db:init      (prisma db push)
//
// HISTORY — WHY THE SHAPE LOOKS LIKE THIS
//
// The application was migrated from PHP + MySQL. The original shipped no schema
// file and no migrations, so these models were reconstructed from the queries the
// PHP code issued (PROJECT_ANALYSIS.md §4):
//
//   users    dashboard.php:17      SELECT * FROM users ORDER BY id DESC
//            dashboard.php:46-49   reads id, email, passw, created_at
//            delete_user.php:6     DELETE FROM users WHERE id = ...
//            check_new_user.php:9  SELECT MAX(id) AS last_id FROM users
//   coupons  dashboard.php:13      INSERT INTO coupons (coupon_code) VALUES ...
//            dashboard.php:20      SELECT * FROM coupons ORDER BY id DESC LIMIT 1
//
// Table and column names are kept exactly as the PHP used them — including
// `passw` rather than `password` — so that a PHP instance and this app can read
// the same database during a cutover.
//
// The datasource moved from MySQL to Postgres because the deployment target is
// Vercel, whose storage partners offer Postgres and no MySQL. That was only
// possible once the database was confirmed to be starting fresh: an earlier
// constraint, that a separate signup application wrote to `users` over mysqli,
// would have made the change a cross-application rewrite. See db/README.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from the datasource block. The connection string now
// lives in `prisma.config.ts` (for CLI commands) and is passed to the driver
// adapter in `src/lib/prisma.ts` (for the running app).
datasource db {
  provider = "postgresql"
}

/// Accounts created by the signup flow. This panel lists and deletes them; it
/// never creates them.
model User {
  id    Int     @id @default(autoincrement())
  email String? @db.VarChar(255)

  /// Plaintext password, preserved exactly as the PHP dashboard displayed it.
  /// This is a known security finding, kept deliberately rather than silently
  /// changed — see PROJECT_ANALYSIS.md §7 finding 2 before touching it.
  /// The column is named `passw`, not `password`.
  passw String? @db.VarChar(255)

  /// Second precision with no fractional part, matching the MySQL DATETIME this
  /// replaced, so the dashboard renders the same `YYYY-MM-DD HH:MM:SS` string
  /// that the PHP page printed. Rendered in UTC by lib/format.ts.
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(0)

  @@map("users")
}

/// Discount codes entered by the admin. The original panel only ever INSERTs a
/// bare code and reads back the newest row — there is no amount, expiry, or
/// redemption column, and none was added.
model Coupon {
  id         Int     @id @default(autoincrement())
  couponCode String? @map("coupon_code") @db.VarChar(255)

  @@map("coupons")
}
